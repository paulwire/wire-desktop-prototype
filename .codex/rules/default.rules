# Codex execpolicy rules
# Note: these govern commands the `codex` CLI agent may run directly during
# `codex exec` (e.g. in scripts/codex-review.sh), not general shell/CI
# permissions. Codex reviews PRs; it must not post, push, or merge them.

prefix_rule(
    pattern = ["gh", "api"],
    decision = "prompt",
)

prefix_rule(
    pattern = ["git", "push", "--force"],
    decision = "forbidden",
)

prefix_rule(
    pattern = ["gh", "pr", "create"],
    decision = "forbidden",
)

prefix_rule(
    pattern = ["gh", "pr", "merge"],
    decision = "forbidden",
)

prefix_rule(
    pattern = ["git", "push"],
    decision = "forbidden",
)
