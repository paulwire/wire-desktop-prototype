{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(./gradlew *)",
      "Bash(make *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git push origin *)",
      "Bash(git push)",
      "Bash(git push -u origin *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list*)",
      "Bash(./scripts/codex-review.sh*)",
      "Bash(gh pr checks *)",
      "Bash(gh pr create *)",
      "Bash(codex --version)",
      "Bash(codex --help)",
      "Bash(codex exec --help)",
      "Bash(codex debug --help)",
      "Bash(codex execpolicy --help)",
      "Bash(codex execpolicy check --help)",
      "Bash(codex execpolicy check *)",
      "Bash(chmod +x scripts/*)"
    ],
    "ask": [
      "Bash(gh pr merge *)",
      "Bash(gh api *)",
      "Bash(curl *api.github.com*)",
      "Edit(./.github/**)",
      "Write(./.github/**)"
    ],
    "deny": [
      "Bash(gh pr merge *--admin*)",
      "Bash(git push --force*)",
      "Bash(rm -rf *)",
      "Read(./.env*)",
      "Bash(gh repo delete *)",
      "Edit(../kalium/**)",
      "Write(../kalium/**)"
    ],
    "additionalDirectories": [
      "../kalium"
    ]
  }
}
